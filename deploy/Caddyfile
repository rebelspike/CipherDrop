# Set CIPHERDROP_DOMAIN to the DNS name pointing at this host.
# Caddy obtains/renews a publicly trusted certificate automatically.
{$CIPHERDROP_DOMAIN} {
    encode zstd gzip
    root * ./frontend/dist
    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}
