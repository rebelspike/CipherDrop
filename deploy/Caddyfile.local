https://localhost {
    tls internal

    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * ./frontend/dist
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
